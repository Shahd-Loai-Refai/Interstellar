# Copy this file to .env and fill it in. Never share or commit .env.
# PROVIDER: gemini | anthropic | openai | mock   (mock = no key, placeholder scores)
PROVIDER=gemini
API_KEY=paste-your-key-here
# Optional: model name. Default for gemini is gemini-flash-latest.
# If you get a quota or "model not found" error, try: gemini-2.5-flash
MODEL=
# Optional: server port
PORT=8000
